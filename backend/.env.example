# PayPal SANDBOX credentials (Developer Dashboard -> Apps & Credentials -> Sandbox).
# The app must have the Invoicing feature enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Email of the sandbox BUSINESS (merchant) account; used to block self-invoicing.
PAYPAL_MERCHANT_EMAIL=

# AI parsing: ollama | none (none = regex-only "basic mode")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
LLM_TIMEOUT_S=8

# Shared secret between the desktop app and this backend (any random string).
MERCURY_TOKEN=change-me
